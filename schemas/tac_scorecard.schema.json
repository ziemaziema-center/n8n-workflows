{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TAC Autonomous Controller Scorecard",
  "type": "object",
  "required": [
    "task_id",
    "generated_at",
    "scoring_scope",
    "target_score",
    "baseline_total",
    "strict_external_audit_total",
    "improved_total",
    "target_hit",
    "sectors",
    "agent_council",
    "remaining_deferred_gates"
    ,
    "implemented_gap_fixes"
  ],
  "properties": {
    "task_id": { "type": "string" },
    "generated_at": { "type": "string" },
    "scoring_scope": { "type": "string" },
    "target_score": { "type": "integer", "minimum": 0, "maximum": 100 },
    "baseline_total": { "type": "integer", "minimum": 0, "maximum": 100 },
    "strict_external_audit_total": { "type": "integer", "minimum": 0, "maximum": 100 },
    "improved_total": { "type": "integer", "minimum": 0, "maximum": 100 },
    "target_hit": { "type": "boolean" },
    "agent_council": {
      "type": "array",
      "minItems": 5,
      "items": { "type": "string" }
    },
    "remaining_deferred_gates": {
      "type": "array",
      "items": { "type": "string" }
    },
    "implemented_gap_fixes": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "sectors": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "items": {
        "type": "object",
        "required": [
          "name",
          "baseline_score",
          "improved_score",
          "reason",
          "evidence",
          "remaining_risk",
          "evidence_present"
        ],
        "properties": {
          "name": { "type": "string" },
          "baseline_score": { "type": "integer", "minimum": 0, "maximum": 10 },
          "improved_score": { "type": "integer", "minimum": 0, "maximum": 10 },
          "reason": { "type": "string" },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string" }
          },
          "remaining_risk": { "type": "string" },
          "evidence_present": { "type": "boolean" }
        }
      }
    }
  }
}
