{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "YUNA Growth Experiment",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "experiment_id",
    "created_at_kst",
    "status",
    "owner",
    "hypothesis",
    "audience",
    "content_angle",
    "hook_pattern",
    "behavioral_trigger",
    "expected_action",
    "cta",
    "risk_gate",
    "success_metrics",
    "data_needed",
    "variants",
    "decision_rule",
    "live_operations_performed"
  ],
  "properties": {
    "experiment_id": {
      "type": "string",
      "pattern": "^yuna-growth-[0-9]{8}-[a-z0-9-]+$"
    },
    "created_at_kst": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": ["DRAFT", "READY_FOR_APPROVAL", "RUNNING", "PAUSED", "PASS", "FAIL", "DEFERRED_GATE"]
    },
    "owner": {
      "type": "string"
    },
    "hypothesis": {
      "type": "string",
      "minLength": 20
    },
    "audience": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary_persona", "pain", "desire", "follow_reason"],
      "properties": {
        "primary_persona": { "type": "string" },
        "pain": { "type": "string" },
        "desire": { "type": "string" },
        "follow_reason": { "type": "string" }
      }
    },
    "content_angle": {
      "type": "string"
    },
    "hook_pattern": {
      "type": "string"
    },
    "behavioral_trigger": {
      "type": "string"
    },
    "expected_action": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": ["follow", "save", "share", "comment", "dm_reply", "profile_visit"]
      }
    },
    "cta": {
      "type": "string"
    },
    "risk_gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requires_live_publish", "requires_credential_read", "requires_manual_approval", "notes"],
      "properties": {
        "requires_live_publish": { "type": "boolean" },
        "requires_credential_read": { "type": "boolean" },
        "requires_manual_approval": { "type": "boolean" },
        "notes": { "type": "string" }
      }
    },
    "success_metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary", "secondary", "minimum_signal_threshold"],
      "properties": {
        "primary": {
          "type": "array",
          "items": { "type": "string" }
        },
        "secondary": {
          "type": "array",
          "items": { "type": "string" }
        },
        "minimum_signal_threshold": {
          "type": "string"
        }
      }
    },
    "data_needed": {
      "type": "array",
      "items": { "type": "string" }
    },
    "variants": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["variant_id", "first_frame", "opening_line", "caption_cta", "comment_prompt"],
        "properties": {
          "variant_id": { "type": "string" },
          "first_frame": { "type": "string" },
          "opening_line": { "type": "string" },
          "caption_cta": { "type": "string" },
          "comment_prompt": { "type": "string" }
        }
      }
    },
    "decision_rule": {
      "type": "string"
    },
    "live_operations_performed": {
      "type": "boolean"
    }
  }
}
