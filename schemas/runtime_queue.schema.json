{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mykindredai.local/schemas/runtime_queue.schema.json",
  "title": "TAC Runtime Queue Task",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task_id",
    "created_at",
    "requested_by",
    "source_channel",
    "priority",
    "objective",
    "allowed_scope",
    "deferred_gates",
    "target_runner",
    "tmux_session",
    "workspace_path",
    "validation_commands",
    "expected_artifacts",
    "status",
    "retry_count",
    "max_retries",
    "continuation_ledger_path",
    "final_report_path"
  ],
  "properties": {
    "task_id": {
      "type": "string",
      "pattern": "^(tac|hq)-[A-Za-z0-9._:-]+$"
    },
    "created_at": {
      "type": "string",
      "description": "ISO-8601 timestamp generated by HQ or n8n."
    },
    "requested_by": {
      "type": "string",
      "minLength": 1
    },
    "source_channel": {
      "type": "string",
      "enum": ["telegram", "n8n_webhook", "local_hq", "scheduled", "manual"]
    },
    "priority": {
      "type": "string",
      "enum": ["low", "normal", "high", "urgent"]
    },
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "allowed_scope": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "local_files",
          "offline_tests",
          "docs",
          "templates",
          "scaffold",
          "read_only_logs",
          "dry_run",
          "no_live_network",
          "no_secrets",
          "no_production_mutation"
        ]
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "deferred_gates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "reason", "required_approval"],
        "properties": {
          "name": { "type": "string" },
          "reason": { "type": "string" },
          "required_approval": { "type": "string" }
        }
      }
    },
    "target_runner": {
      "type": "string",
      "enum": ["codex", "reviewer", "dry_run", "planner"]
    },
    "tmux_session": {
      "type": "string",
      "pattern": "^tac-[a-z0-9-]+$"
    },
    "workspace_path": {
      "type": "string",
      "pattern": "^/home/ubuntu/workspace/.+"
    },
    "validation_commands": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "expected_artifacts": {
      "type": "array",
      "items": { "type": "string" }
    },
    "status": {
      "type": "string",
      "enum": ["QUEUED", "RUNNING", "PASS", "FAIL", "DEFERRED_GATE", "CANCELLED"]
    },
    "retry_count": {
      "type": "integer",
      "minimum": 0
    },
    "max_retries": {
      "type": "integer",
      "minimum": 0,
      "maximum": 3
    },
    "continuation_ledger_path": {
      "type": "string"
    },
    "final_report_path": {
      "type": "string"
    }
  }
}
