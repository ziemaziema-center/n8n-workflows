    "code":  "const reelSlots = [\"07:30\", \"18:30\", \"22:20\", \"07:30\"];\nfunction kstNow() {\n  const now = new Date();\n  const parts = new Intl.DateTimeFormat(\"en-CA\", { timeZone: \"Asia/Seoul\", year: \"numeric\", month: \"2-digit\", day: \"2-digit\" }).formatToParts(now);\n  const y = parts.find(p =\u003e p.type === \"year\").value;\n  const m = parts.find(p =\u003e p.type === \"month\").value;\n  const d = parts.find(p =\u003e p.type === \"day\").value;\n  return `${y}-${m}-${d}`;\n}\nfunction extractFirstUrl(value) {\n  if (!value) return \"\";\n  if (Array.isArray(value) \u0026\u0026 value.length) return String(value[0] || \"\").trim();\n  const text = String(value || \"\").trim();\n  if (!text) return \"\";\n  if (text.startsWith(\"[\")) {\n    try {\n      const parsed = JSON.parse(text);\n      if (Array.isArray(parsed) \u0026\u0026 parsed.length) return String(parsed[0] || \"\").trim();\n    } catch (e) {}\n  }\n  return text;\n}\nfunction isValidPublicMp4(url) {\n  const value = String(url || \"\").trim();\n  if (!value || !/^https:\\/\\//i.test(value)) return false;\n  let parsed;\n  try { parsed = new URL(value); } catch (e) { return false; }\n  const host = String(parsed.hostname || \"\").toLowerCase();\n  if (!host || host === \"example.com\" || host.endsWith(\".example.com\")) return false;\n  if (/^(localhost|127\\.|10\\.|192\\.168\\.|172\\.(1[6-9]|2\\d|3[0-1])\\.)/.test(host)) return false;\n  return /\\.mp4($|\\?)/i.test(parsed.pathname + parsed.search);\n}\nfunction pickReelVideoUrl(row) {\n  const candidates = [\n    row.video_url,\n    row.reel_video_url,\n    row.reel_video,\n    row.reel_mp4_url,\n    row.public_video_url,\n    row.video?.url,\n    extractFirstUrl(row.video_urls_json),\n    extractFirstUrl(row.video_urls),\n  ];\n  for (const c of candidates) {\n    const v = String(c || \"\").trim();\n    if (v) return v;\n  }\n  return \"\";\n}\nconst today = kstNow();\nconst reels = items.filter(i =\u003e String(i.json.content_type || \"\").toLowerCase() === \"reel\").sort((a, b) =\u003e Number(b.json.score || 0) - Number(a.json.score || 0));\nconst feeds = items.filter(i =\u003e String(i.json.content_type || \"\").toLowerCase() === \"feed\").sort((a, b) =\u003e Number(b.json.score || 0) - Number(a.json.score || 0));\nconst normalized = [];\n\nreels.forEach((item, idx) =\u003e {\n  const row = item.json;\n  const slot = reelSlots[idx] || \"07:30\";\n  const subtitles = Array.isArray(row.scene_json) ? row.scene_json.map(s =\u003e s.caption).filter(Boolean).join(\" | \") : String(row.reel_script || row.body || row.final_title || \"\");\n  const imageUrl = String(row.cover_url || row.image_url || row.photo || extractFirstUrl(row.image_urls_json) || extractFirstUrl(row.image_urls) || \"\").trim();\n  const videoUrl = pickReelVideoUrl(row);\n  if (!isValidPublicMp4(videoUrl)) return;\n\n  const required = [row.final_title, row.body, subtitles, row.source_link, row.hashtags, slot, videoUrl];\n  if (required.some(v =\u003e !String(v || \"\").trim())) return;\n\n  const contentId = String(row.content_key || row.content_id || \"\").trim();\n  normalized.push({\n    json: {\n      ...row,\n      content_id: contentId,\n      platform: \"reel\",\n      title: row.final_title,\n      body: row.body,\n      subtitles,\n      source_url: row.source_link,\n      hashtags: row.hashtags,\n      image_url: imageUrl || String(row.cover_url || row.image_url || \"\").trim(),\n      video_url: videoUrl,\n      time_slot: `${today} ${slot}`,\n      status: \"draft\",\n      telegram_message_id: \"\",\n      content_key: contentId\n    }\n  });\n});\n\nfeeds.forEach((item) =\u003e {\n  const row = item.json;\n  const subtitles = String(row.body || row.final_title || \"\");\n  const imageUrl = String(row.cover_url || row.image_url || row.photo || extractFirstUrl(row.image_urls_json) || extractFirstUrl(row.image_urls) || row.data?.[0]?.url || \"\").trim();\n  const videoUrl = String(row.video_url || row.reel_video_url || row.cover_url || row.photo || imageUrl || \"\").trim();\n  const required = [row.final_title, row.body, subtitles, row.source_link, row.hashtags, imageUrl, videoUrl];\n  if (required.some(v =\u003e !String(v || \"\").trim())) return;\n  const contentId = String(row.content_key || row.content_id || \"\").trim();\n  normalized.push({ json: { ...row, content_id: contentId, platform: \"feed\", title: row.final_title, body: row.body, subtitles, source_url: row.source_link, hashtags: row.hashtags, image_url: imageUrl || String(row.cover_url || row.image_url || \"\").trim(), video_url: videoUrl, time_slot: `${today} 21:58`, status: \"draft\", telegram_message_id: \"\", content_key: contentId } });\n});\n\nreturn normalized;"
