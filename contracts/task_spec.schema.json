{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.true-autonomous-controller/contracts/task_spec.schema.json",
  "title": "TRUE Autonomous Controller Task Spec",
  "type": "object",
  "required": [
    "task_id",
    "requested_phase",
    "source",
    "prompt",
    "workspace",
    "execution_mode",
    "risk_level",
    "limits",
    "commands"
  ],
  "properties": {
    "task_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{2,80}$"
    },
    "requested_phase": {
      "type": "integer",
      "minimum": 0,
      "maximum": 3
    },
    "source": {
      "type": "string",
      "enum": ["telegram", "n8n", "manual", "test"]
    },
    "prompt": {
      "type": "string",
      "minLength": 1
    },
    "workspace": {
      "type": "string",
      "minLength": 1
    },
    "execution_mode": {
      "type": "string",
      "enum": ["dry_run", "local_command"]
    },
    "risk_level": {
      "type": "string",
      "enum": ["read_only", "workspace_write", "risky", "blocked"]
    },
    "limits": {
      "type": "object",
      "required": ["max_iterations", "max_runtime_sec", "retry_limit", "cost_ceiling_usd"],
      "properties": {
        "max_iterations": { "type": "integer", "minimum": 1, "maximum": 10 },
        "max_runtime_sec": { "type": "integer", "minimum": 1, "maximum": 1800 },
        "retry_limit": { "type": "integer", "minimum": 0, "maximum": 3 },
        "cost_ceiling_usd": { "type": "number", "minimum": 0, "maximum": 5 }
      },
      "additionalProperties": false
    },
    "commands": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": {
        "type": "object",
        "required": ["id", "argv"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_.-]{1,64}$"
          },
          "argv": {
            "type": "array",
            "minItems": 1,
            "maxItems": 20,
            "items": { "type": "string" }
          },
          "allow_failure": {
            "type": "boolean",
            "default": false
          }
        },
        "additionalProperties": false
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": {
        "type": ["string", "number", "boolean", "null"]
      }
    }
  },
  "additionalProperties": false
}

