    {
      "parameters": {
        "jsCode": "const original = $items('Wait Before Publish', 0, 0)[0]?.json || {};\nconst response = items[0]?.json || {};\nconst publishId = String(response.id || response.media_id || '').trim();\nconst errorMessage = response.error?.message || response.error?.error_user_msg || response.message || response.error || '';\n\nreturn [{\n  json: {\n    ok: !!publishId,\n    stage: 'publish_media',\n    ig_user_id: original.ig_user_id,\n    creation_id: original.creation_id,\n    publish_id: publishId,\n    publish_error: publishId ? '' : String(errorMessage || 'Publish failed').slice(0, 300),\n    raw_publish_response: response,\n    published_at: new Date().toISOString()\n  }\n}];"
