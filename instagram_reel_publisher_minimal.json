        "jsCode": "const original = $items('Prepare Publish Payload', 0, 0)[0]?.json || {};\nconst response = items[0]?.json || {};\nconst creationId = String(response.id || response.creation_id || '').trim();\nconst errorMessage = response.error?.message || response.error?.error_user_msg || response.message || response.error || '';\n\nreturn [{\n  json: {\n    ...original,\n    create_attempt: 1,\n    creation_id: creationId,\n    create_status: creationId ? 'success' : 'retry',\n    create_error: creationId ? '' : String(errorMessage || 'Create media container failed').slice(0, 300),\n    raw_create_response: response\n  }\n}];"
