    {
      "parameters": {
        "jsCode": "const input = $json || {};\n\nconst accessToken = String(input.access_token || 'PASTE_USER_ACCESS_TOKEN_HERE').trim();\nconst igUserId = String(input.ig_user_id || '17841436538210981').trim();\nconst videoUrl = String(input.video_url || 'https://YOUR_PUBLIC_MP4_URL_HERE.mp4').trim();\nconst caption = String(input.caption || 'test reel').trim();\nconst publishDelaySeconds = Number(input.publish_delay_seconds || 8);\nconst retryDelaySeconds = Number(input.retry_delay_seconds || 10);\n\nif (!accessToken || accessToken === 'PASTE_USER_ACCESS_TOKEN_HERE') throw new Error('Missing Instagram user access token');\nif (!igUserId) throw new Error('Missing Instagram user ID');\nif (!videoUrl || videoUrl === 'https://YOUR_PUBLIC_MP4_URL_HERE.mp4') throw new Error('Missing video URL');\n\nreturn [{\n  json: {\n    ...input,\n    ig_user_id: igUserId,\n    access_token: accessToken,\n    video_url: videoUrl,\n    caption,\n    publish_delay_seconds: publishDelaySeconds,\n    retry_delay_seconds: retryDelaySeconds,\n    create_attempt: 1\n  }\n}];"
      },
