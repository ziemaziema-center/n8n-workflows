    {
      "parameters": {
        "jsCode": "const input = $input.first()?.json || {};\nconst body = input.body && typeof input.body === 'object' ? input.body : input;\nconst msg = body.message || body.edited_message || {};\nconst chat = body.chat || msg.chat || {};\nconst rawText = String(body.text || body.command || body.prompt || msg.text || '').trim();\nconst chatId = String(body.chat_id || chat.id || '').trim();\nconst taskIdRaw = String(body.task_id || '').trim();\nlet action = 'run';\nlet prompt = rawText;\nlet task_id = taskIdRaw;\nlet executor = String(body.executor || '').trim().toLowerCase() === 'codex' ? 'codex' : 'dry_run';\nif (/^\\/killall\\b/i.test(rawText) || String(body.action || '').toLowerCase() === 'killall') {\n  action = 'killall';\n  prompt = rawText;\n} else if (/^\\/status\\b/i.test(rawText) || String(body.action || '').toLowerCase() === 'status') {\n  action = 'status';\n  task_id = taskIdRaw || rawText.replace(/^\\/status\\s*/i, '').trim();\n} else if (/^\\/codex\\b/i.test(rawText)) {\n  action = 'run';\n  executor = 'codex';\n  prompt = rawText.replace(/^\\/codex\\s*/i, '').trim() || 'Return TAC_CODEX_SMOKE_OK';\n} else if (/^\\/run\\b/i.test(rawText)) {\n  action = 'run';\n  prompt = rawText.replace(/^\\/run\\s*/i, '').trim() || 'Phase 3 smoke run';\n}\nconst endpoint = action === 'killall' ? 'killall' : action === 'status' ? 'status' : 'run';\nconst runner_url = `http://172.17.0.1:8765/${endpoint}`;\nreturn [{ json: { action, runner_url, prompt, task_id, chat_id: chatId, source: 'n8n', executor, received_text: rawText } }];"
      },
      "id": "tac-normalize-command",
      "name": "Normalize TAC Command",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -520,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$json.runner_url}}",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "prompt",
              "value": "={{$json.prompt}}"
            },
            {
              "name": "task_id",
              "value": "={{$json.task_id}}"
            },
            {
              "name": "source",
              "value": "n8n"
            },
            {
              "name": "executor",
              "value": "={{$json.executor}}"
            }
          ]
        },
        "options": {
          "timeout": 60000,
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        }
      },
      "id": "tac-call-runner",
      "name": "Call TAC Runner",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -280,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const response = $json || {};\nconst result = response.result || {};\nconst status = String(result.status || (response.ok ? 'PASS' : 'UNKNOWN'));\nconst taskId = String(result.task_id || response.task_id || $node['Normalize TAC Command'].json.task_id || 'unknown');\nconst summary = String(result.summary || response.message || response.error || 'No summary returned').slice(0, 3000);\nconst text = [\n  '[TRUE AUTONOMOUS CONTROLLER]',\n  `status: ${status}`,\n  `task: ${taskId}`,\n  '',\n  summary,\n  '',\n  `checked_at: ${new Date().toISOString()}`\n].join('\\n').slice(0, 3900);\nreturn [{ json: { ok: !!response.ok, status, task_id: taskId, telegram_text: text, chat_id: $node['Normalize TAC Command'].json.chat_id, runner_response: response } }];"
      },
      "id": "tac-build-summary",
      "name": "Build Telegram Summary",
