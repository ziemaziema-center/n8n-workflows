                      "parameters":  {
                                         "jsCode":  "const response = $json || {};\nconst result = response.result || {};\nconst status = String(result.status || (response.ok ? \u0027PASS\u0027 : \u0027UNKNOWN\u0027));\nconst taskId = String(result.task_id || response.task_id || $node[\u0027Normalize Telegram Command\u0027].json.task_id || \u0027unknown\u0027);\nconst summary = String(result.summary || response.message || response.error || \u0027No summary returned\u0027).slice(0, 3300);\nconst text = [\n  \u0027[TRUE AUTONOMOUS CONTROLLER]\u0027,\n  `status: ${status}`,\n  `task: ${taskId}`,\n  \u0027\u0027,\n  summary,\n  \u0027\u0027,\n  \u0027commands:\u0027,\n  `/status ${taskId}`,\n  \u0027/killall\u0027\n].join(\u0027\\n\u0027).slice(0, 3900);\nreturn [{ json: { status, task_id: taskId, telegram_text: text, chat_id: $node[\u0027Normalize Telegram Command\u0027].json.chat_id } }];"
