                  {
                      "parameters":  {
                                         "jsCode":  "const update = $input.first()?.json || {};\nconst msg = update.message || update.edited_message || {};\nconst chat = msg.chat || {};\nconst rawText = String(msg.text || \u0027\u0027).trim();\nconst chatId = String(chat.id || \u0027\u0027).trim();\nlet action = \u0027\u0027;\nlet prompt = \u0027\u0027;\nlet task_id = \u0027\u0027;\nlet executor = \u0027dry_run\u0027;\nif (/^\\/run\\b/i.test(rawText)) {\n  action = \u0027run\u0027;\n  prompt = rawText.replace(/^\\/run\\s*/i, \u0027\u0027).trim() || \u0027Phase 3 smoke run\u0027;\n} else if (/^\\/codex\\b/i.test(rawText)) {\n  action = \u0027run\u0027;\n  executor = \u0027codex\u0027;\n  prompt = rawText.replace(/^\\/codex\\s*/i, \u0027\u0027).trim() || \u0027Return TAC_CODEX_SMOKE_OK\u0027;\n} else if (/^\\/status\\b/i.test(rawText)) {\n  action = \u0027status\u0027;\n  task_id = rawText.replace(/^\\/status\\s*/i, \u0027\u0027).trim();\n} else if (/^\\/killall\\b/i.test(rawText)) {\n  action = \u0027killall\u0027;\n} else if (rawText \u0026\u0026 !rawText.startsWith(\u0027/\u0027)) {\n  action = \u0027run\u0027;\n  executor = \u0027codex\u0027;\n  prompt = [\n    \u0027FOLLOWUP_TASK: true\u0027,\n    \u0027Telegram follow-up message. First inspect the latest TAC task/result if needed and continue from the most recent related bounded workspace.\u0027,\n    \u0027If this is an approval, execute only the approved bounded scope and keep forbidden live mutations blocked unless explicitly approved.\u0027,\n    \u0027\u0027,\n    \u0027User message:\u0027,\n    rawText,\n  ].join(\u0027\\n\u0027);\n}\nfunction makeTaskId() {\n  const stamp = new Date().toISOString().replace(/[-:TZ.]/g, \u0027\u0027).slice(0, 14);\n  const rand = Math.random().toString(16).slice(2, 10).padEnd(8, \u00270\u0027);\n  return `tac-${stamp}-${rand}`;\n}\nif (action === \u0027run\u0027 \u0026\u0026 !task_id) {\n  task_id = makeTaskId();\n}\nconst supported = !!action \u0026\u0026 !!chatId;\nconst endpoint = action === \u0027killall\u0027 ? \u0027killall\u0027 : action === \u0027status\u0027 ? \u0027status\u0027 : \u0027run\u0027;\nreturn [{ json: { supported, action, endpoint, runner_url: `http://172.17.0.1:8765/${endpoint}`, prompt, task_id, chat_id: chatId, executor, received_text: rawText } }];"
                                     },
