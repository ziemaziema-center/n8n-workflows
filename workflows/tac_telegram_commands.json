        "jsCode": "const command = $node['Normalize Telegram Command'].json || {};\nconst taskId = String(command.task_id || 'starting');\nconst text = [\n  '[TRUE AUTONOMOUS CONTROLLER]',\n  'status: RECEIVED',\n  `task: ${taskId}`,\n  '',\n  '명령 접수. Codex 실행을 시작합니다.',\n  '완료되면 최종 보고를 다시 보냅니다.',\n  '',\n  'commands:',\n  `/status ${taskId}`,\n  '/killall'\n].join('\\n').slice(0, 3900);\nreturn [{ json: { chat_id: command.chat_id, telegram_text: text } }];"
      },
