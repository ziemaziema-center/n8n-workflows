                  {
                      "parameters":  {
                                         "jsCode":  "const command = $node[\u0027Normalize Telegram Command\u0027].json || {};\nconst taskId = String(command.task_id || \u0027starting\u0027);\nconst raw = String(command.received_text || command.prompt || \u0027\u0027).trim();\nconst isCodex = String(command.executor || \u0027\u0027) === \u0027codex\u0027;\nconst isFollowup = raw \u0026\u0026 !raw.startsWith(\u0027/\u0027);\nconst hasWorkspace = /WORKSPACE\\s*[:=]/i.test(raw) || /\\/home\\/ubuntu\\/workspace\\//.test(raw);\nconst eta = isCodex ? (raw.length \u003e 500 ? \u00275-30 min\u0027 : \u00271-5 min\u0027) : \u0027under 1 min\u0027;\nconst direction = isFollowup\n  ? \u0027Continue the latest related bounded workspace as a follow-up.\u0027\n  : isCodex\n    ? \u0027Plan, inspect memory, execute bounded Codex work, validate, then report.\u0027\n    : \u0027Run controller smoke/status workflow and return result.\u0027;\nconst hqRoute = [\n  \u0027HQ: parse user intent and safety bounds\u0027,\n  \u0027Orchestrator: create task id and dispatch to TAC runner\u0027,\n  \u0027Agent: Codex executes inside bounded workspace\u0027,\n  \u0027Reviewer: controller checks exit status and summary\u0027,\n  \u0027Reporter: Telegram sends final output and status commands\u0027\n];\nconst plan = [\n  hasWorkspace ? \u0027Use the requested WORKSPACE path.\u0027 : \u0027Use latest bounded workspace if this is a follow-up; otherwise controller workspace.\u0027,\n  \u0027Read memory/boot files before acting when present.\u0027,\n  \u0027Avoid secrets, live trading, Docker restart, workflow activation, and production mutation unless explicitly approved.\u0027,\n  \u0027Run validation that fits the approved scope.\u0027,\n  \u0027Send final report with findings, changes, validation, risks, and approvals needed.\u0027\n];\nconst text = [\n  \u0027[TRUE AUTONOMOUS CONTROLLER]\u0027,\n  \u0027status: RECEIVED\u0027,\n  `task: ${taskId}`,\n  \u0027\u0027,\n  `expected_time: ${eta}`,\n  \u0027\u0027,\n  \u0027expected_direction:\u0027,\n  direction,\n  \u0027\u0027,\n  \u0027hq_agent_flow:\u0027,\n  ...hqRoute.map(x =\u003e `- ${x}`),\n  \u0027\u0027,\n  \u0027execution_plan:\u0027,\n  ...plan.map(x =\u003e `- ${x}`),\n  \u0027\u0027,\n  \u0027commands:\u0027,\n  `/status ${taskId}`,\n  \u0027/killall\u0027\n].join(\u0027\\n\u0027).slice(0, 3900);\nreturn [{ json: { chat_id: command.chat_id, telegram_text: text } }];"
