      "id": "tac-call-runner-from-telegram",
      "name": "Call TAC Runner",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -120,
        -120
      ]
    },
    {
      "parameters": {
        "jsCode": "const response = $json || {};\nconst result = response.result || {};\nconst status = String(result.status || (response.ok ? 'PASS' : 'UNKNOWN'));\nconst taskId = String(result.task_id || response.task_id || $node['Normalize Telegram Command'].json.task_id || 'unknown');\nconst summary = String(result.summary || response.message || response.error || 'No summary returned').slice(0, 3300);\nconst text = [\n  '[TRUE AUTONOMOUS CONTROLLER]',\n  `status: ${status}`,\n  `task: ${taskId}`,\n  '',\n  summary,\n  '',\n  'commands:',\n  `/status ${taskId}`,\n  '/killall'\n].join('\\n').slice(0, 3900);\nreturn [{ json: { status, task_id: taskId, telegram_text: text, chat_id: $node['Normalize Telegram Command'].json.chat_id } }];"
      },
