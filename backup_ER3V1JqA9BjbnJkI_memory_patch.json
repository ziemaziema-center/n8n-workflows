                  {
                      "parameters":  {
                                         "jsCode":  "const raw = $json.choices?.[0]?.message?.content || \u0027{}\u0027;\n\nfunction extractJson(text) {\n  const cleaned = String(text || \u0027\u0027).trim();\n  const f1 = cleaned.match(/```json\\s*([\\s\\S]*?)\\s*```/i);\n  if (f1) return f1[1].trim();\n  const f2 = cleaned.match(/```([\\s\\S]*?)```/);\n  if (f2) return f2[1].trim();\n  const first = cleaned.indexOf(\u0027{\u0027);\n  const last = cleaned.lastIndexOf(\u0027}\u0027);\n  if (first !== -1 \u0026\u0026 last !== -1) return cleaned.slice(first, last + 1);\n  return \u0027{}\u0027;\n}\n\nlet parsed = {};\ntry {\n  parsed = JSON.parse(extractJson(raw));\n} catch (e) {\n  parsed = {};\n}\n\nconst now = new Date().toISOString();\n\nconst rules = Array.isArray(parsed.current_rules) ? parsed.current_rules : [];\n\nreturn rules\n  .map((rule, idx) =\u003e ({\n    json: {\n      rule_priority: Number(rule.rule_priority || idx + 1),\n      rule_text: String(rule.rule_text || \u0027\u0027).trim(),\n      updated_at: now\n    }\n  }))\n  .filter(item =\u003e item.json.rule_text);"
