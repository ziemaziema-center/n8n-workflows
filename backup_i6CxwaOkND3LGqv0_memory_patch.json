                      "parameters":  {
                                         "mode":  "runOnceForEachItem",
                                         "jsCode":  "const raw = $json.choices?.[0]?.message?.content || \u0027{}\u0027;\n\nfunction extractJson(text) {\n  const cleaned = String(text || \u0027\u0027).trim();\n  const f1 = cleaned.match(/```json\\s*([\\s\\S]*?)\\s*```/i);\n  if (f1) return f1[1].trim();\n  const f2 = cleaned.match(/```([\\s\\S]*?)```/);\n  if (f2) return f2[1].trim();\n  const first = cleaned.indexOf(\u0027{\u0027);\n  const last = cleaned.lastIndexOf(\u0027}\u0027);\n  if (first !== -1 \u0026\u0026 last !== -1) return cleaned.slice(first, last + 1);\n  return \u0027{}\u0027;\n}\n\nfunction normalizeResult(r) {\n  const val = String(r || \u0027\u0027).toLowerCase();\n  if (val.includes(\u0027good\u0027)) return \u0027good\u0027;\n  if (val.includes(\u0027bad\u0027)) return \u0027bad\u0027;\n  return \u0027bad\u0027;\n}\n\nlet parsed = {};\nlet fail = false;\n\ntry {\n  parsed = JSON.parse(extractJson(raw));\n} catch {\n  fail = true;\n}\n\nconst fallback =\n  String($json.thumbnail_hook || $json.final_title || \u0027\u0027).trim();\n\nreturn [{\n  json: {\n    hook: String(parsed.hook || fallback).slice(0, 120),\n    performance_score: Number(parsed.performance_score || 0),\n    result: fail ? \u0027bad\u0027 : normalizeResult(parsed.result),\n    reason: fail ? \u0027parse failed\u0027 : String(parsed.reason || \u0027\u0027).slice(0, 60),\n    logged_at: new Date().toISOString()\n  }\n}];"
                                     },
